{
  "name": "@tardigrde/openclaw-dropbox-plugin",
  "version": "2.0.4",
  "description": "OpenClaw plugin for Dropbox integration — list, download, upload, share, search, and delete files",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "skills",
    "openclaw.plugin.json"
  ],
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.7.1",
      "minGatewayVersion": "2026.7.1"
    },
    "build": {
      "openclawVersion": "2026.7.1",
      "pluginSdkVersion": "2026.7.1"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest"
  },
  "keywords": [
    "openclaw",
    "plugin",
    "dropbox",
    "file-management"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tardigrde/openclaw-dropbox-plugin"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@sinclair/typebox": "^0.34.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.0"
  }
}
