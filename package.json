{
  "name": "@tardigrde/openclaw-dropbox-plugin",
  "version": "2.0.1",
  "description": "OpenClaw plugin for Dropbox integration — list, download, upload, share, search, and delete files",
  "type": "module",
  "main": "index.ts",
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "compat": {
      "pluginApi": ">=2026.3.22",
      "minGatewayVersion": "2026.3.22"
    },
    "build": {
      "openclawVersion": "2026.3.22",
      "pluginSdkVersion": "2026.3.22"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest"
  },
  "keywords": [
    "openclaw",
    "plugin",
    "dropbox",
    "file-management"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tardigrde/openclaw-dropbox-plugin"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@sinclair/typebox": "^0.34.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.3.22"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.0"
  }
}
