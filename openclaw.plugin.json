{
  "id": "dropbox",
  "name": "Dropbox",
  "description": "File management tools for Dropbox — list, download, upload, share, search, and delete",
  "setup": {
    "providers": [
      {
        "id": "dropbox",
        "envVars": ["DROPBOX_ACCESS_TOKEN"]
      }
    ]
  },
  "contracts": {
    "tools": [
      "dropbox_list",
      "dropbox_download",
      "dropbox_upload",
      "dropbox_share",
      "dropbox_search",
      "dropbox_delete"
    ]
  },
  "activation": {
    "onStartup": false
  },
  "skills": ["skills/dropbox"],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "maxDownloadBytes": {
        "type": "number",
        "description": "Maximum file size in bytes allowed for download (default: 104857600 = 100MB)",
        "default": 104857600
      }
    }
  },
  "uiHints": {
    "category": "cloud-storage",
    "icon": "cloud"
  }
}
